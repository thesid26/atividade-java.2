import java.util.Scanner;

public class SistemaBancario {

    public static final int TAM_CONTAS = 50;
    public static final int TAM_OP = 1000;
    public static Scanner input = new Scanner(System.in);

    public static class Conta {
        int id;
        String cliente;
        double saldo;
        double limite;
    }

    public static class Operacao {
        int id;
        int idConta;
        char tipo; // ('D', 'S', 'T')
        double valor;
    }

    // Função fornecida pelo enunciado (implementada para o código compilar e rodar)
    public static int buscaId(Conta[] v, int tam, int x) {
        for (int i = 0; i < tam; i++) {
            if (v[i].id == x) {
                return i;
            }
        }
        return -1;
    }

  
    // 1) CADASTRAR CONTA E FUNÇÃO AUXILIAR
 
    public static int cadastrarConta(Conta[] v, int tam) {
        if (tam >= TAM_CONTAS) {
            System.out.println("Erro: Limite máximo de contas atingido.");
            return tam;
        }

        Conta nova = lerDadosConta(v, tam);
        if (nova == null) {
            return tam;
        }

        v[tam] = nova;
        System.out.println("Conta cadastrada com sucesso!");
        return tam + 1;
    }

    public static Conta lerDadosConta(Conta[] v, int tam) {
        Conta c = new Conta();

        System.out.print("Digite o ID da conta: ");
        c.id = input.nextInt();
        input.nextLine(); // Limpar buffer

        if (buscaId(v, tam, c.id) != -1) {
            System.out.println("Erro: ID já cadastrado.");
            return null;
        }

        System.out.print("Digite o nome do cliente: ");
        c.cliente = input.nextLine();

        System.out.print("Digite o saldo inicial: ");
        c.saldo = input.nextDouble();

        System.out.print("Digite o limite da conta: ");
        c.limite = input.nextDouble();

        if (c.saldo < 0 || c.limite < 0) {
            System.out.println("Erro: Saldo e limite não podem ser negativos.");
            return null;
        }

        return c;
    }

    // 2) BUSCA BINÁRIA POR CLIENTE

    public static int buscaBinariaCliente(Conta[] v, int tam, String x) {
        int inicio = 0;
        int fim = tam - 1;

        while (inicio <= fim) {
            int meio = (inicio + fim) / 2;
            int comparacao = v[meio].cliente.compareToIgnoreCase(x);

            if (comparacao == 0) {
                return meio;
            } else if (comparacao < 0) {
                inicio = meio + 1;
            } else {
                fim = meio - 1;
            }
        }
        return -1;
    }

   
    // 3) ORDENAÇÃO POR INSERÇÃO DIRETA (INSERTION SORT) POR CLIENTE
 
    public static int insertionSortCliente(Conta[] v, int tam) {
        for (int i = 1; i < tam; i++) {
            Conta chave = v[i];
            int j = i - 1;

            while (j >= 0 && v[j].cliente.compareToIgnoreCase(chave.cliente) > 0) {
                v[j + 1] = v[j];
                j--;
            }
            v[j + 1] = chave;
        }
        return tam;
    }

    
    // 4) FILTRAR OPERAÇÕES DE UMA CONTA
    public static int filtraOperacoes(Operacao[] vOp, int tamOp, Operacao[] vOpFiltrado, int x) {
        int tamFiltrado = 0;

        for (int i = 0; i < tamOp; i++) {
            if (vOp[i].idConta == x) {
                vOpFiltrado[tamFiltrado] = vOp[i];
                tamFiltrado++;
            }
        }
        return tamFiltrado;
    }

  
    // 5) IMPRIMIR EXTRATO E FUNÇÕES AUXILIARES

    public static void extrato(Conta[] vContas, int tamConta, Operacao[] vOp, int tamOp) {
        System.out.print("Digite o ID da conta para emitir o extrato: ");
        int idBuscado = input.nextInt();

        int posConta = buscaId(vContas, tamConta, idBuscado);
        if (posConta == -1) {
            System.out.println("Conta não encontrada.");
            return;
        }

        Conta conta = vContas[posConta];
        Operacao[] opConta = new Operacao[TAM_OP];
        int totalOp = filtraOperacoes(vOp, tamOp, opConta, idBuscado);

        int inicio = (totalOp > 5) ? (totalOp - 5) : 0;

        double saldoAcumulado = 0.0;
        for (int i = 0; i < inicio; i++) {
            saldoAcumulado += opConta[i].valor;
        }

        System.out.println("+--------------------------------------------------+");
        System.out.printf("| %-38s N.%03d     |\n", "C O N T A", conta.id);
        System.out.println("+--------------------------------------------------+");
        System.out.printf("| CLIENTE: %-39s |\n", conta.cliente);
        System.out.println("+--------------------------------------------------+");
        System.out.printf("| %-4s | %-15s | %-10s | %-10s |\n", "ID", "OPERAÇÃO", "VALOR", "SALDO");
        System.out.println("+------+-----------------+------------+------------+");
        System.out.printf("| %-4s | %-15s | %-10s | %10s |\n", "", "Saldo Anterior", "", formatarMoeda(saldoAcumulado));

        for (int i = inicio; i < totalOp; i++) {
            Operacao op = opConta[i];
            saldoAcumulado += op.valor;

            String descTipo = obterDescricaoTipo(op.tipo);
            String valorFormatado = formatarMoeda(op.valor);
            String saldoFormatado = formatarMoeda(saldoAcumulado);

            System.out.printf("| %04d | %-15s | %10s | %10s |\n", op.id, descTipo, valorFormatado, saldoFormatado);
        }

        System.out.println("+------+-----------------+------------+------------+");
        System.out.printf("| %-37s | %10s |\n", "Saldo Atual", formatarMoeda(saldoAcumulado));
        System.out.println("+---------------------------------------+------------+");
    }

    public static String obterDescricaoTipo(char tipo) {
        switch (Character.toUpperCase(tipo)) {
            case 'D': return "Depósito";
            case 'S': return "Saque";
            case 'T': return "Transferência";
            default:  return "Outra";
        }
    }

    public static String formatarMoeda(double valor) {
        char indicador = (valor >= 0) ? 'C' : 'D';
        return String.format("%.2f%c", Math.abs(valor), indicador);
    }

    
